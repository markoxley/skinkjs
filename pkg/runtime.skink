//
// File:    pkg/runtime.skink
// Purpose: Emits the self-contained JavaScript runtime prelude (__skink) and
//          isomorphic standard-library shims (std/str, std/fmt, std/strconv,
//          std/math, std/errors, std/path, std/json, std/time, std/regex,
//          std/rand, std/sort, std/base64, std/crypto, std/os, std/fs,
//          std/testing, std/buf, std/sync, std/tensor) for browser and Node.js.
// Author:  Mark Oxley
// Created: 2026

module runtime

import "std/str"

// IsRuntimeBackedStdModule reports whether a resolved module name belongs to
// the C/runtime-backed standard library modules provided directly by the JS runtime.
pub fn IsRuntimeBackedStdModule(modName: string) -> bool {
    if str.Equal(modName, "libc") || str.Equal(modName, "str") || str.Equal(modName, "buf") {
        return true
    }
    if str.Equal(modName, "fmt") || str.Equal(modName, "strconv") || str.Equal(modName, "math") {
        return true
    }
    if str.Equal(modName, "errors") || str.Equal(modName, "path") || str.Equal(modName, "json") {
        return true
    }
    if str.Equal(modName, "time") || str.Equal(modName, "regex") || str.Equal(modName, "rand") {
        return true
    }
    if str.Equal(modName, "sort") || str.Equal(modName, "base64") || str.Equal(modName, "crypto") {
        return true
    }
    if str.Equal(modName, "os") || str.Equal(modName, "fs") || str.Equal(modName, "io") {
        return true
    }
    if str.Equal(modName, "testing") || str.Equal(modName, "sync") || str.Equal(modName, "waitgroup") {
        return true
    }
    if str.Equal(modName, "reflect") || str.Equal(modName, "tensor") {
        return true
    }
    if str.Equal(modName, "js") || str.Equal(modName, "dom") {
        return true
    }
    return false
}

// EmitRuntimePrelude returns the JavaScript source code defining `__skink` and
// the built-in helpers + standard-library module functions.
pub fn EmitRuntimePrelude() -> string {
    sb := str.NewBuilder(16384)

    str.Write(&sb, "// --- Skink JavaScript Runtime Prelude ---\n")
    str.Write(&sb, "const __skink = (() => {\n")
    str.Write(&sb, "  const isNode = typeof process !== \"undefined\" && process.versions != null && process.versions.node != null;\n")
    str.Write(&sb, "  let _activePanic = null;\n")
    str.Write(&sb, "  let _printBuf = \"\";\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function formatVal(v) {\n")
    str.Write(&sb, "    if (v === null || v === undefined) return \"nil\";\n")
    str.Write(&sb, "    if (typeof v === \"boolean\") return v ? \"true\" : \"false\";\n")
    str.Write(&sb, "    if (typeof v === \"number\") return Number.isFinite(v) ? String(v) : String(v);\n")
    str.Write(&sb, "    if (typeof v === \"string\") return v;\n")
    str.Write(&sb, "    if (Array.isArray(v)) return \"[\" + v.map(formatVal).join(\", \") + \"]\";\n")
    str.Write(&sb, "    if (v instanceof Set) return \"set{\" + Array.from(v).map(formatVal).join(\", \") + \"}\";\n")
    str.Write(&sb, "    if (typeof v === \"object\") {\n")
    str.Write(&sb, "      if (v.__ref && typeof v.get === \"function\") return formatVal(v.get());\n")
    str.Write(&sb, "      if (typeof v.String === \"function\") return v.String();\n")
    str.Write(&sb, "      if (v.__tag) {\n")
    str.Write(&sb, "        if (v.__values && v.__values.length > 0) return v.__tag + \"(\" + v.__values.map(formatVal).join(\", \") + \")\";\n")
    str.Write(&sb, "        return v.__tag;\n")
    str.Write(&sb, "      }\n")
    str.Write(&sb, "      const keys = Object.keys(v).filter(k => !k.startsWith(\"__\"));\n")
    str.Write(&sb, "      const body = keys.map(k => k + \": \" + formatVal(v[k])).join(\", \");\n")
    str.Write(&sb, "      return (v.__type ? v.__type : \"\") + \"{\" + body + \"}\";\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "    return String(v);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function print(...args) {\n")
    str.Write(&sb, "    const text = args.map(formatVal).join(\"\");\n")
    str.Write(&sb, "    if (isNode && process.stdout && typeof process.stdout.write === \"function\") {\n")
    str.Write(&sb, "      process.stdout.write(text);\n")
    str.Write(&sb, "    } else {\n")
    str.Write(&sb, "      _printBuf += text;\n")
    str.Write(&sb, "      const nl = _printBuf.lastIndexOf(\"\\n\");\n")
    str.Write(&sb, "      if (nl >= 0) {\n")
    str.Write(&sb, "        console.log(_printBuf.slice(0, nl));\n")
    str.Write(&sb, "        _printBuf = _printBuf.slice(nl + 1);\n")
    str.Write(&sb, "      }\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function println(...args) {\n")
    str.Write(&sb, "    const text = args.map(formatVal).join(\"\");\n")
    str.Write(&sb, "    if (isNode && process.stdout && typeof process.stdout.write === \"function\") {\n")
    str.Write(&sb, "      process.stdout.write(text + \"\\n\");\n")
    str.Write(&sb, "    } else {\n")
    str.Write(&sb, "      if (_printBuf.length > 0) {\n")
    str.Write(&sb, "        console.log(_printBuf + text);\n")
    str.Write(&sb, "        _printBuf = \"\";\n")
    str.Write(&sb, "      } else {\n")
    str.Write(&sb, "        console.log(text);\n")
    str.Write(&sb, "      }\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function len(v) {\n")
    str.Write(&sb, "    if (v === null || v === undefined) return 0;\n")
    str.Write(&sb, "    if (typeof v === \"string\" || Array.isArray(v)) return v.length;\n")
    str.Write(&sb, "    if (v instanceof Set || v instanceof Map) return v.size;\n")
    str.Write(&sb, "    if (v.__chan) return v._queue.length;\n")
    str.Write(&sb, "    if (v.__tensor) return v.data.length;\n")
    str.Write(&sb, "    if (typeof v === \"object\") return Object.keys(v).filter(k => !k.startsWith(\"__\")).length;\n")
    str.Write(&sb, "    return 0;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function cap(v) {\n")
    str.Write(&sb, "    if (v === null || v === undefined) return 0;\n")
    str.Write(&sb, "    if (Array.isArray(v)) return v._cap !== undefined ? v._cap : v.length;\n")
    str.Write(&sb, "    if (v.__chan) return v._cap;\n")
    str.Write(&sb, "    return len(v);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function append(arr, ...items) {\n")
    str.Write(&sb, "    const base = Array.isArray(arr) ? arr.slice() : [];\n")
    str.Write(&sb, "    for (let i = 0; i < items.length; i++) base.push(items[i]);\n")
    str.Write(&sb, "    return base;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function copy(dst, src) {\n")
    str.Write(&sb, "    if (!Array.isArray(dst) || !Array.isArray(src)) return 0;\n")
    str.Write(&sb, "    const n = Math.min(dst.length, src.length);\n")
    str.Write(&sb, "    for (let i = 0; i < n; i++) dst[i] = src[i];\n")
    str.Write(&sb, "    return n;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function del(col, key) {\n")
    str.Write(&sb, "    if (!col) return;\n")
    str.Write(&sb, "    if (col instanceof Set || col instanceof Map) { col.delete(key); return; }\n")
    str.Write(&sb, "    delete col[key];\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function clear(col) {\n")
    str.Write(&sb, "    if (!col) return;\n")
    str.Write(&sb, "    if (Array.isArray(col)) { col.length = 0; return; }\n")
    str.Write(&sb, "    if (col instanceof Set || col instanceof Map) { col.clear(); return; }\n")
    str.Write(&sb, "    if (typeof col === \"object\") {\n")
    str.Write(&sb, "      for (const k of Object.keys(col)) { if (!k.startsWith(\"__\")) delete col[k]; }\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function contains(col, item) {\n")
    str.Write(&sb, "    if (col === null || col === undefined) return false;\n")
    str.Write(&sb, "    if (typeof col === \"string\") return col.includes(String(item));\n")
    str.Write(&sb, "    if (Array.isArray(col)) return col.includes(item);\n")
    str.Write(&sb, "    if (col instanceof Set || col instanceof Map) return col.has(item);\n")
    str.Write(&sb, "    if (typeof col === \"object\") return Object.prototype.hasOwnProperty.call(col, item);\n")
    str.Write(&sb, "    return false;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function idx(target, index) {\n")
    str.Write(&sb, "    if (typeof target === \"string\") return target.charCodeAt(index) | 0;\n")
    str.Write(&sb, "    if (target && target.__tensor) return target.data[index];\n")
    str.Write(&sb, "    return target[index];\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function idxFromEnd(target, offset) {\n")
    str.Write(&sb, "    const n = len(target);\n")
    str.Write(&sb, "    return idx(target, n - offset);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function setIdx(target, index, val, fromEnd) {\n")
    str.Write(&sb, "    const realIdx = fromEnd ? (len(target) - index) : index;\n")
    str.Write(&sb, "    if (target && target.__tensor) { target.data[realIdx] = val; return val; }\n")
    str.Write(&sb, "    target[realIdx] = val;\n")
    str.Write(&sb, "    return val;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function slice(target, low, high) {\n")
    str.Write(&sb, "    if (target === null || target === undefined) return [];\n")
    str.Write(&sb, "    const start = (low === null || low === undefined) ? 0 : low;\n")
    str.Write(&sb, "    const end = (high === null || high === undefined) ? target.length : high;\n")
    str.Write(&sb, "    return target.slice(start, end);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function addrOf(getter, setter) {\n")
    str.Write(&sb, "    const v = getter();\n")
    str.Write(&sb, "    if (v !== null && typeof v === \"object\" && !Array.isArray(v)) {\n")
    str.Write(&sb, "      return new Proxy(v, {\n")
    str.Write(&sb, "        get(t, prop) {\n")
    str.Write(&sb, "          if (prop === \"__ref\") return true;\n")
    str.Write(&sb, "          if (prop === \"get\") return getter;\n")
    str.Write(&sb, "          if (prop === \"set\") return setter;\n")
    str.Write(&sb, "          const cur = getter();\n")
    str.Write(&sb, "          const val = cur[prop];\n")
    str.Write(&sb, "          return typeof val === \"function\" ? val.bind(cur) : val;\n")
    str.Write(&sb, "        },\n")
    str.Write(&sb, "        set(t, prop, val) {\n")
    str.Write(&sb, "          const cur = getter();\n")
    str.Write(&sb, "          cur[prop] = val;\n")
    str.Write(&sb, "          return true;\n")
    str.Write(&sb, "        }\n")
    str.Write(&sb, "      });\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "    return { __ref: true, get: getter, set: setter };\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function deref(p) {\n")
    str.Write(&sb, "    if (p && p.__ref && typeof p.get === \"function\") return p.get();\n")
    str.Write(&sb, "    return p;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function setRef(p, val) {\n")
    str.Write(&sb, "    if (p && p.__ref && typeof p.set === \"function\") { p.set(val); return val; }\n")
    str.Write(&sb, "    if (p && typeof p === \"object\" && val && typeof val === \"object\") { Object.assign(p, val); return val; }\n")
    str.Write(&sb, "    return val;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function cloneStruct(obj) {\n")
    str.Write(&sb, "    if (obj === null || typeof obj !== \"object\") return obj;\n")
    str.Write(&sb, "    if (obj.__ref && typeof obj.get === \"function\") return cloneStruct(obj.get());\n")
    str.Write(&sb, "    return Object.assign(Object.create(Object.getPrototypeOf(obj)), obj);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function panic(msg) {\n")
    str.Write(&sb, "    const text = formatVal(msg);\n")
    str.Write(&sb, "    _activePanic = text;\n")
    str.Write(&sb, "    const err = new Error(\"panic: \" + text);\n")
    str.Write(&sb, "    err.__skinkPanic = true;\n")
    str.Write(&sb, "    err.skinkMessage = text;\n")
    str.Write(&sb, "    throw err;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function recover() {\n")
    str.Write(&sb, "    if (_activePanic !== null) {\n")
    str.Write(&sb, "      const msg = _activePanic;\n")
    str.Write(&sb, "      _activePanic = null;\n")
    str.Write(&sb, "      return msg;\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "    return \"\";\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function hasActivePanic() { return _activePanic !== null; }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function assert(cond, msg) {\n")
    str.Write(&sb, "    if (!cond) panic(msg || \"assertion failed\");\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function toInt(v) {\n")
    str.Write(&sb, "    if (typeof v === \"boolean\") return v ? 1 : 0;\n")
    str.Write(&sb, "    if (typeof v === \"number\") return Math.trunc(v);\n")
    str.Write(&sb, "    if (typeof v === \"string\") return parseInt(v, 10) || 0;\n")
    str.Write(&sb, "    return 0;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function toFloat(v) {\n")
    str.Write(&sb, "    if (typeof v === \"boolean\") return v ? 1.0 : 0.0;\n")
    str.Write(&sb, "    if (typeof v === \"number\") return v;\n")
    str.Write(&sb, "    if (typeof v === \"string\") return parseFloat(v) || 0.0;\n")
    str.Write(&sb, "    return 0.0;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function toString(v) {\n")
    str.Write(&sb, "    if (typeof v === \"string\") return v;\n")
    str.Write(&sb, "    return formatVal(v);\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function makeChan(capacity = 0) {\n")
    str.Write(&sb, "    return {\n")
    str.Write(&sb, "      __chan: true,\n")
    str.Write(&sb, "      _cap: capacity,\n")
    str.Write(&sb, "      _queue: [],\n")
    str.Write(&sb, "      _closed: false,\n")
    str.Write(&sb, "      send(val) {\n")
    str.Write(&sb, "        if (this._closed) panic(\"send on closed channel\");\n")
    str.Write(&sb, "        this._queue.push(val);\n")
    str.Write(&sb, "      },\n")
    str.Write(&sb, "      recv() {\n")
    str.Write(&sb, "        if (this._queue.length > 0) return this._queue.shift();\n")
    str.Write(&sb, "        return undefined;\n")
    str.Write(&sb, "      },\n")
    str.Write(&sb, "      recvOk() {\n")
    str.Write(&sb, "        if (this._queue.length > 0) return [this._queue.shift(), true];\n")
    str.Write(&sb, "        return [undefined, !this._closed];\n")
    str.Write(&sb, "      },\n")
    str.Write(&sb, "      hasData() { return this._queue.length > 0; },\n")
    str.Write(&sb, "      close() { this._closed = true; }\n")
    str.Write(&sb, "    };\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function closeChan(ch) {\n")
    str.Write(&sb, "    if (ch && typeof ch.close === \"function\") ch.close();\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function spawnTask(fn) {\n")
    str.Write(&sb, "    try { fn(); } catch (e) { setTimeout(() => { throw e; }, 0); }\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function asyncCall(fn) {\n")
    str.Write(&sb, "    try {\n")
    str.Write(&sb, "      const value = fn();\n")
    str.Write(&sb, "      return { __future: true, _resolved: true, _value: value, _error: null };\n")
    str.Write(&sb, "    } catch (err) {\n")
    str.Write(&sb, "      return { __future: true, _resolved: true, _value: null, _error: err };\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function awaitVal(fut) {\n")
    str.Write(&sb, "    if (fut && fut.__future) {\n")
    str.Write(&sb, "      if (fut._error) throw fut._error;\n")
    str.Write(&sb, "      return fut._value;\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "    return fut;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function makeVariant(enumName, tag, ...values) {\n")
    str.Write(&sb, "    const obj = { __enum: enumName, __tag: tag, __values: values };\n")
    str.Write(&sb, "    for (let i = 0; i < values.length; i++) obj[\"_\" + i] = values[i];\n")
    str.Write(&sb, "    return obj;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function matchVariant(subject, tag) {\n")
    str.Write(&sb, "    if (subject === null || subject === undefined) return false;\n")
    str.Write(&sb, "    const shortTag = tag.includes(\".\") ? tag.slice(tag.lastIndexOf(\".\") + 1) : tag;\n")
    str.Write(&sb, "    if (typeof subject === \"object\" && subject.__tag) return subject.__tag === shortTag || subject.__tag === tag;\n")
    str.Write(&sb, "    if (typeof subject === \"function\" && subject.__tag) return subject.__tag === shortTag || subject.__tag === tag;\n")
    str.Write(&sb, "    return subject === tag;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function checkErrProp(val) {\n")
    str.Write(&sb, "    if (Array.isArray(val) && val.length >= 2) {\n")
    str.Write(&sb, "      const last = val[val.length - 1];\n")
    str.Write(&sb, "      if (last && typeof last === \"object\" && typeof last.message === \"string\") {\n")
    str.Write(&sb, "        if (last.message !== \"\") {\n")
    str.Write(&sb, "          const e = new Error(last.message);\n")
    str.Write(&sb, "          e.__skinkErrProp = last;\n")
    str.Write(&sb, "          throw e;\n")
    str.Write(&sb, "        }\n")
    str.Write(&sb, "        return val.length === 2 ? val[0] : val.slice(0, -1);\n")
    str.Write(&sb, "      }\n")
    str.Write(&sb, "    }\n")
    str.Write(&sb, "    return val;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function nonNull(val) {\n")
    str.Write(&sb, "    if (val === null || val === undefined) panic(\"non-null assertion failed on nil value\");\n")
    str.Write(&sb, "    return val;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  function makeTensor(shape, initVal = 0) {\n")
    str.Write(&sb, "    const dims = Array.isArray(shape) ? shape : [shape];\n")
    str.Write(&sb, "    const size = dims.reduce((a, b) => a * b, 1);\n")
    str.Write(&sb, "    return { __tensor: true, shape: dims, data: new Array(size).fill(initVal) };\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "\n")
    str.Write(&sb, "  return {\n")
    str.Write(&sb, "    isNode, formatVal, print, println, len, cap, append, copy, del, clear, contains,\n")
    str.Write(&sb, "    idx, idxFromEnd, setIdx, slice, addrOf, deref, setRef, cloneStruct,\n")
    str.Write(&sb, "    panic, recover, hasActivePanic, assert, toInt, toFloat, toString,\n")
    str.Write(&sb, "    makeChan, closeChan, spawnTask, asyncCall, awaitVal, makeVariant, matchVariant,\n")
    str.Write(&sb, "    checkErrProp, nonNull, makeTensor\n")
    str.Write(&sb, "  };\n")
    str.Write(&sb, "})();\n")

    // Emit standard library shims so imported std/* functions work natively in JS
    str.Write(&sb, "\n// --- Skink Standard Library Shims ---\n")

    // std/str
    str.Write(&sb, "const str_Len = (s) => (s ? s.length : 0);\n")
    str.Write(&sb, "const str_Compare = (a, b) => (a === b ? 0 : (a < b ? -1 : 1));\n")
    str.Write(&sb, "const str_Equal = (a, b) => a === b;\n")
    str.Write(&sb, "const str_Contains = (s, sub) => (s || \"\").includes(sub || \"\");\n")
    str.Write(&sb, "const str_Concat = (a, b) => String(a ?? \"\") + String(b ?? \"\");\n")
    str.Write(&sb, "const str_Substr = (s, start, length) => {\n")
    str.Write(&sb, "  const strVal = String(s ?? \"\");\n")
    str.Write(&sb, "  const st = Math.max(0, Math.min(strVal.length, start | 0));\n")
    str.Write(&sb, "  const len = Math.max(0, Math.min(strVal.length - st, length | 0));\n")
    str.Write(&sb, "  return strVal.slice(st, st + len);\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const str_Trim = (s) => String(s ?? \"\").trim();\n")
    str.Write(&sb, "const str_StartsWith = (s, prefix) => String(s ?? \"\").startsWith(String(prefix ?? \"\"));\n")
    str.Write(&sb, "const str_EndsWith = (s, suffix) => String(s ?? \"\").endsWith(String(suffix ?? \"\"));\n")
    str.Write(&sb, "const str_IndexOf = (s, part) => String(s ?? \"\").indexOf(String(part ?? \"\"));\n")
    str.Write(&sb, "const str_LastIndexOf = (s, part) => String(s ?? \"\").lastIndexOf(String(part ?? \"\"));\n")
    str.Write(&sb, "const str_Split = (s, sep) => (sep === \"\" ? [String(s ?? \"\")] : String(s ?? \"\").split(String(sep)));\n")
    str.Write(&sb, "const str_Join = (parts, sep) => (Array.isArray(parts) ? parts.join(String(sep ?? \"\")) : \"\");\n")
    str.Write(&sb, "const str_Replace = (s, oldStr, newStr) => (!oldStr ? String(s ?? \"\") : String(s ?? \"\").split(String(oldStr)).join(String(newStr ?? \"\")));\n")
    str.Write(&sb, "const str_ToLower = (s) => String(s ?? \"\").toLowerCase();\n")
    str.Write(&sb, "const str_ToUpper = (s) => String(s ?? \"\").toUpperCase();\n")
    str.Write(&sb, "const str_Repeat = (s, count) => (count > 0 ? String(s ?? \"\").repeat(count | 0) : \"\");\n")
    str.Write(&sb, "const str_NewBuilder = (cap = 64) => ({ __type: \"str.Builder\", buf: \"\", len: 0, cap: cap });\n")
    str.Write(&sb, "const str_Write = (b, s) => { const t = __skink.deref(b); t.buf += String(s ?? \"\"); t.len = t.buf.length; };\n")
    str.Write(&sb, "const str_WriteByte = (b, c) => { const t = __skink.deref(b); t.buf += String.fromCharCode(c & 0xff); t.len = t.buf.length; };\n")
    str.Write(&sb, "const str_String = (b) => { const t = __skink.deref(b); return t ? t.buf : \"\"; };\n")
    str.Write(&sb, "const str_BuilderValue = (b) => str_String(b);\n")
    str.Write(&sb, "const str_LenBuilder = (b) => { const t = __skink.deref(b); return t ? t.buf.length : 0; };\n")
    str.Write(&sb, "const str_Reset = (b) => { const t = __skink.deref(b); if (t) { t.buf = \"\"; t.len = 0; } };\n")
    str.Write(&sb, "const str_Free = (b) => str_Reset(b);\n")

    // std/buf
    str.Write(&sb, "const buf_NewBuffer = () => ({\n")
    str.Write(&sb, "  __type: \"buf.Buffer\", data: \"\", len: 0, cap: 64,\n")
    str.Write(&sb, "  WriteString(s) { this.data += String(s ?? \"\"); this.len = this.data.length; },\n")
    str.Write(&sb, "  WriteByte(c) { this.data += String.fromCharCode(c & 0xff); this.len = this.data.length; },\n")
    str.Write(&sb, "  WriteInt(n) { this.data += String(n | 0); this.len = this.data.length; },\n")
    str.Write(&sb, "  String() { return this.data; },\n")
    str.Write(&sb, "  Len() { return this.len; },\n")
    str.Write(&sb, "  Reset() { this.data = \"\"; this.len = 0; },\n")
    str.Write(&sb, "  Truncate(n) { if (n >= 0 && n < this.len) { this.data = this.data.slice(0, n); this.len = n; } },\n")
    str.Write(&sb, "  Free() { this.data = \"\"; this.len = 0; }\n")
    str.Write(&sb, "});\n")

    // std/fmt
    str.Write(&sb, "const fmt_Itoa = (n) => String(Math.trunc(n));\n")
    str.Write(&sb, "const fmt_Ftoa = (f) => Number(f).toFixed(6);\n")
    str.Write(&sb, "const fmt_Btoa = (b) => (b ? \"true\" : \"false\");\n")
    str.Write(&sb, "const fmt_Sprintf1s = (tmpl, a1) => String(tmpl).replace(\"{}\", String(a1));\n")
    str.Write(&sb, "const fmt_Sprintf1d = (tmpl, a1) => String(tmpl).replace(\"{}\", String(Math.trunc(a1)));\n")
    str.Write(&sb, "const fmt_Sprintf1f = (tmpl, a1) => String(tmpl).replace(\"{}\", Number(a1).toFixed(6));\n")
    str.Write(&sb, "const fmt_Sprintf2s = (tmpl, a1, a2) => String(tmpl).replace(\"{}\", String(a1)).replace(\"{}\", String(a2));\n")

    // std/strconv
    str.Write(&sb, "const strconv_Itoa = (n) => String(Math.trunc(n));\n")
    str.Write(&sb, "const strconv_Atoi = (s) => { const v = parseInt(String(s).trim(), 10); return Number.isNaN(v) ? [0, false] : [v, true]; };\n")
    str.Write(&sb, "const strconv_ParseInt = (s) => {\n")
    str.Write(&sb, "  const t = String(s ?? \"\").trim();\n")
    str.Write(&sb, "  if (!/^[+-]?\\d+$/.test(t)) return [0, false];\n")
    str.Write(&sb, "  const v = Number(t);\n")
    str.Write(&sb, "  if (v > 2147483647 || v < -2147483648) return [0, false];\n")
    str.Write(&sb, "  return [v | 0, true];\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const strconv_ParseInt64 = (s) => {\n")
    str.Write(&sb, "  const t = String(s ?? \"\").trim();\n")
    str.Write(&sb, "  if (!/^[+-]?\\d+$/.test(t)) return [0, false];\n")
    str.Write(&sb, "  return [Number(t), true];\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const strconv_ParseFloat = (s) => {\n")
    str.Write(&sb, "  const t = String(s ?? \"\").trim();\n")
    str.Write(&sb, "  if (t.length === 0) return [0.0, false];\n")
    str.Write(&sb, "  const v = Number(t);\n")
    str.Write(&sb, "  return Number.isNaN(v) ? [0.0, false] : [v, true];\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const strconv_ParseBool = (s) => {\n")
    str.Write(&sb, "  const t = String(s ?? \"\").trim().toLowerCase();\n")
    str.Write(&sb, "  if (t === \"true\" || t === \"1\") return [true, true];\n")
    str.Write(&sb, "  if (t === \"false\" || t === \"0\") return [false, true];\n")
    str.Write(&sb, "  return [false, false];\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const strconv_FormatInt = (n) => String(Math.trunc(n));\n")
    str.Write(&sb, "const strconv_FormatFloat = (f, prec = 6) => Number(f).toFixed(prec);\n")
    str.Write(&sb, "const strconv_FormatBool = (b) => (b ? \"true\" : \"false\");\n")

    // std/math
    str.Write(&sb, "const math_Pi = Math.PI;\n")
    str.Write(&sb, "const math_E = Math.E;\n")
    str.Write(&sb, "const math_Sqrt2 = Math.SQRT2;\n")
    str.Write(&sb, "const math_Ln2 = Math.LN2;\n")
    str.Write(&sb, "const math_Ln10 = Math.LN10;\n")
    str.Write(&sb, "const math_Sqrt = Math.sqrt;\n")
    str.Write(&sb, "const math_Sin = Math.sin;\n")
    str.Write(&sb, "const math_Cos = Math.cos;\n")
    str.Write(&sb, "const math_Tan = Math.tan;\n")
    str.Write(&sb, "const math_Asin = Math.asin;\n")
    str.Write(&sb, "const math_Acos = Math.acos;\n")
    str.Write(&sb, "const math_Atan = Math.atan;\n")
    str.Write(&sb, "const math_Atan2 = Math.atan2;\n")
    str.Write(&sb, "const math_Sinh = Math.sinh;\n")
    str.Write(&sb, "const math_Cosh = Math.cosh;\n")
    str.Write(&sb, "const math_Tanh = Math.tanh;\n")
    str.Write(&sb, "const math_Pow = Math.pow;\n")
    str.Write(&sb, "const math_Exp = Math.exp;\n")
    str.Write(&sb, "const math_Log = Math.log;\n")
    str.Write(&sb, "const math_Log10 = Math.log10;\n")
    str.Write(&sb, "const math_Ceil = Math.ceil;\n")
    str.Write(&sb, "const math_Floor = Math.floor;\n")
    str.Write(&sb, "const math_Round = Math.round;\n")
    str.Write(&sb, "const math_Abs = Math.abs;\n")
    str.Write(&sb, "const math_Min = Math.min;\n")
    str.Write(&sb, "const math_Max = Math.max;\n")
    str.Write(&sb, "const math_Clamp = (x, lo, hi) => Math.min(Math.max(x, lo), hi);\n")

    // std/errors
    str.Write(&sb, "const errors_New = (message = \"\") => ({\n")
    str.Write(&sb, "  __type: \"errors.Error\", message: String(message ?? \"\"),\n")
    str.Write(&sb, "  String() { return this.message; },\n")
    str.Write(&sb, "  Error() { return this.message; }\n")
    str.Write(&sb, "});\n")
    str.Write(&sb, "const errors_None = () => errors_New(\"\");\n")
    str.Write(&sb, "const errors_Is = (a, b) => ((a && a.message) || \"\") === ((b && b.message) || \"\");\n")
    str.Write(&sb, "const errors_Wrap = (err, prefix) => errors_New(String(prefix) + \": \" + ((err && err.message) || \"\"));\n")

    // std/path
    str.Write(&sb, "const path_Join = (parts) => (Array.isArray(parts) ? parts.join(\"/\").replace(/\\/+/g, \"/\") : \"\");\n")
    str.Write(&sb, "const path_Base = (p) => {\n")
    str.Write(&sb, "  const s = String(p ?? \"\").replace(/\\/+$/, \"\");\n")
    str.Write(&sb, "  if (!s) return p && p.startsWith(\"/\") ? \"/\" : \"\";\n")
    str.Write(&sb, "  const idx = s.lastIndexOf(\"/\");\n")
    str.Write(&sb, "  return idx < 0 ? s : s.slice(idx + 1);\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const path_Dir = (p) => {\n")
    str.Write(&sb, "  const s = String(p ?? \"\").replace(/\\/+$/, \"\");\n")
    str.Write(&sb, "  if (!s) return p && p.startsWith(\"/\") ? \"/\" : \".\";\n")
    str.Write(&sb, "  const idx = s.lastIndexOf(\"/\");\n")
    str.Write(&sb, "  if (idx < 0) return \".\";\n")
    str.Write(&sb, "  return idx === 0 ? \"/\" : s.slice(0, idx);\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const path_Ext = (p) => {\n")
    str.Write(&sb, "  const b = path_Base(p);\n")
    str.Write(&sb, "  const dot = b.lastIndexOf(\".\");\n")
    str.Write(&sb, "  return dot <= 0 ? \"\" : b.slice(dot);\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const path_IsAbs = (p) => String(p ?? \"\").startsWith(\"/\");\n")

    // std/json
    str.Write(&sb, "function _jsToSkinkJSON(val) {\n")
    str.Write(&sb, "  if (val === null || val === undefined) return { __type: \"json.Value\", kind: 0, strVal: \"\", numVal: 0, boolVal: false, arr: [], objKeys: [], objVals: [] };\n")
    str.Write(&sb, "  if (typeof val === \"boolean\") return { __type: \"json.Value\", kind: 1, strVal: \"\", numVal: 0, boolVal: val, arr: [], objKeys: [], objVals: [] };\n")
    str.Write(&sb, "  if (typeof val === \"number\") return { __type: \"json.Value\", kind: 2, strVal: \"\", numVal: val, boolVal: false, arr: [], objKeys: [], objVals: [] };\n")
    str.Write(&sb, "  if (typeof val === \"string\") return { __type: \"json.Value\", kind: 3, strVal: val, numVal: 0, boolVal: false, arr: [], objKeys: [], objVals: [] };\n")
    str.Write(&sb, "  if (Array.isArray(val)) return { __type: \"json.Value\", kind: 4, strVal: \"\", numVal: 0, boolVal: false, arr: val.map(_jsToSkinkJSON), objKeys: [], objVals: [] };\n")
    str.Write(&sb, "  if (typeof val === \"object\") {\n")
    str.Write(&sb, "    const keys = Object.keys(val);\n")
    str.Write(&sb, "    return { __type: \"json.Value\", kind: 5, strVal: \"\", numVal: 0, boolVal: false, arr: [], objKeys: keys, objVals: keys.map(k => _jsToSkinkJSON(val[k])) };\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "  return _jsToSkinkJSON(null);\n")
    str.Write(&sb, "}\n")
    str.Write(&sb, "function _skinkJSONToJS(v) {\n")
    str.Write(&sb, "  if (!v || v.kind === 0) return null;\n")
    str.Write(&sb, "  if (v.kind === 1) return Boolean(v.boolVal);\n")
    str.Write(&sb, "  if (v.kind === 2) return Number(v.numVal);\n")
    str.Write(&sb, "  if (v.kind === 3) return String(v.strVal);\n")
    str.Write(&sb, "  if (v.kind === 4) return (v.arr || []).map(_skinkJSONToJS);\n")
    str.Write(&sb, "  if (v.kind === 5) {\n")
    str.Write(&sb, "    const out = {};\n")
    str.Write(&sb, "    const keys = v.objKeys || [];\n")
    str.Write(&sb, "    const vals = v.objVals || [];\n")
    str.Write(&sb, "    for (let i = 0; i < keys.length; i++) out[keys[i]] = _skinkJSONToJS(vals[i]);\n")
    str.Write(&sb, "    return out;\n")
    str.Write(&sb, "  }\n")
    str.Write(&sb, "  return null;\n")
    str.Write(&sb, "}\n")
    str.Write(&sb, "const json_Null = () => _jsToSkinkJSON(null);\n")
    str.Write(&sb, "const json_FromBool = (b) => _jsToSkinkJSON(Boolean(b));\n")
    str.Write(&sb, "const json_FromNumber = (n) => _jsToSkinkJSON(Number(n));\n")
    str.Write(&sb, "const json_FromString = (s) => _jsToSkinkJSON(String(s));\n")
    str.Write(&sb, "const json_FromArray = (arr) => ({ __type: \"json.Value\", kind: 4, strVal: \"\", numVal: 0, boolVal: false, arr: arr || [], objKeys: [], objVals: [] });\n")
    str.Write(&sb, "const json_FromObject = (keys, vals) => ({ __type: \"json.Value\", kind: 5, strVal: \"\", numVal: 0, boolVal: false, arr: [], objKeys: keys || [], objVals: vals || [] });\n")
    str.Write(&sb, "const json_IsNull = (v) => !v || v.kind === 0;\n")
    str.Write(&sb, "const json_AsBool = (v) => Boolean(v && v.boolVal);\n")
    str.Write(&sb, "const json_AsNumber = (v) => Number((v && v.numVal) || 0);\n")
    str.Write(&sb, "const json_AsString = (v) => String((v && v.strVal) || \"\");\n")
    str.Write(&sb, "const json_ArrayLen = (v) => (v && v.arr ? v.arr.length : 0);\n")
    str.Write(&sb, "const json_ArrayGet = (v, i) => (v && v.arr ? v.arr[i] : json_Null());\n")
    str.Write(&sb, "const json_ObjectLen = (v) => (v && v.objKeys ? v.objKeys.length : 0);\n")
    str.Write(&sb, "const json_ObjectGet = (v, key) => {\n")
    str.Write(&sb, "  if (!v || !v.objKeys) return json_Null();\n")
    str.Write(&sb, "  const idx = v.objKeys.indexOf(key);\n")
    str.Write(&sb, "  return idx >= 0 ? v.objVals[idx] : json_Null();\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const json_GetString = (v, key) => json_AsString(json_ObjectGet(v, key));\n")
    str.Write(&sb, "const json_GetNumber = (v, key) => json_AsNumber(json_ObjectGet(v, key));\n")
    str.Write(&sb, "const json_GetInt = (v, key) => Math.trunc(json_AsNumber(json_ObjectGet(v, key)));\n")
    str.Write(&sb, "const json_GetBool = (v, key) => json_AsBool(json_ObjectGet(v, key));\n")
    str.Write(&sb, "const json_GetObject = (v, key) => json_ObjectGet(v, key);\n")
    str.Write(&sb, "const json_GetArray = (v, key) => json_ObjectGet(v, key);\n")
    str.Write(&sb, "const json_MarshalValue = (v) => JSON.stringify(_skinkJSONToJS(v));\n")
    str.Write(&sb, "const json_Marshal = (v) => [JSON.stringify(_skinkJSONToJS(v)), errors_None()];\n")
    str.Write(&sb, "const json_Unmarshal = (s) => {\n")
    str.Write(&sb, "  try { return [_jsToSkinkJSON(JSON.parse(String(s))), errors_None()]; }\n")
    str.Write(&sb, "  catch (e) { return [json_Null(), errors_New(e.message || \"invalid JSON\")]; }\n")
    str.Write(&sb, "};\n")

    // std/time
    str.Write(&sb, "const time_Nanosecond = 1;\n")
    str.Write(&sb, "const time_Microsecond = 1000;\n")
    str.Write(&sb, "const time_Millisecond = 1000000;\n")
    str.Write(&sb, "const time_Second = 1000000000;\n")
    str.Write(&sb, "const time_Minute = 60 * 1000000000;\n")
    str.Write(&sb, "const time_Hour = 3600 * 1000000000;\n")
    str.Write(&sb, "const time_NowUnix = () => Math.floor(Date.now() / 1000);\n")
    str.Write(&sb, "const time_NowMillis = () => Date.now();\n")
    str.Write(&sb, "const time_NowNanos = () => Date.now() * 1000000;\n")
    str.Write(&sb, "const time_SleepMillis = (ms) => { const end = Date.now() + ms; while (Date.now() < end) {} };\n")

    // std/rand
    str.Write(&sb, "const rand_Intn = (n) => (n <= 0 ? 0 : Math.floor(Math.random() * n));\n")
    str.Write(&sb, "const rand_Float64 = () => Math.random();\n")
    str.Write(&sb, "const rand_IntRange = (min, max) => min + Math.floor(Math.random() * (max - min + 1));\n")

    // std/sort
    str.Write(&sb, "const sort_Ints = (arr) => { if (Array.isArray(arr)) arr.sort((a, b) => a - b); return arr; };\n")
    str.Write(&sb, "const sort_Floats = (arr) => { if (Array.isArray(arr)) arr.sort((a, b) => a - b); return arr; };\n")
    str.Write(&sb, "const sort_Strings = (arr) => { if (Array.isArray(arr)) arr.sort(); return arr; };\n")

    // std/regex
    str.Write(&sb, "function _makeRegexObj(pattern, re) {\n")
    str.Write(&sb, "  return {\n")
    str.Write(&sb, "    __type: \"regex.Regex\", handle: re ? 1 : 0, Pattern: pattern, _re: re,\n")
    str.Write(&sb, "    Match(text) { return this._re ? this._re.test(String(text)) : false; },\n")
    str.Write(&sb, "    MatchString(text) {\n")
    str.Write(&sb, "      if (!this._re) return false;\n")
    str.Write(&sb, "      const s = String(text);\n")
    str.Write(&sb, "      const m = this._re.exec(s);\n")
    str.Write(&sb, "      return Boolean(m && m.index === 0 && m[0].length === s.length);\n")
    str.Write(&sb, "    },\n")
    str.Write(&sb, "    Find(text) {\n")
    str.Write(&sb, "      if (!this._re) return { __type: \"regex.Match\", Start: -1, End: -1, Text: \"\" };\n")
    str.Write(&sb, "      const m = this._re.exec(String(text));\n")
    str.Write(&sb, "      if (!m) return { __type: \"regex.Match\", Start: -1, End: -1, Text: \"\" };\n")
    str.Write(&sb, "      return { __type: \"regex.Match\", Start: m.index, End: m.index + m[0].length, Text: m[0] };\n")
    str.Write(&sb, "    },\n")
    str.Write(&sb, "    FindAll(text) {\n")
    str.Write(&sb, "      if (!this._re) return [];\n")
    str.Write(&sb, "      const g = new RegExp(this.Pattern, \"g\");\n")
    str.Write(&sb, "      const out = [];\n")
    str.Write(&sb, "      let m;\n")
    str.Write(&sb, "      while ((m = g.exec(String(text))) !== null) {\n")
    str.Write(&sb, "        out.push({ __type: \"regex.Match\", Start: m.index, End: m.index + m[0].length, Text: m[0] });\n")
    str.Write(&sb, "        if (m[0].length === 0) g.lastIndex++;\n")
    str.Write(&sb, "      }\n")
    str.Write(&sb, "      return out;\n")
    str.Write(&sb, "    },\n")
    str.Write(&sb, "    ReplaceAll(text, repl) {\n")
    str.Write(&sb, "      if (!this._re) return String(text);\n")
    str.Write(&sb, "      const g = new RegExp(this.Pattern, \"g\");\n")
    str.Write(&sb, "      return String(text).replace(g, String(repl));\n")
    str.Write(&sb, "    },\n")
    str.Write(&sb, "    Free() { this._re = null; this.handle = 0; }\n")
    str.Write(&sb, "  };\n")
    str.Write(&sb, "}\n")
    str.Write(&sb, "const regex_Compile = (pattern) => {\n")
    str.Write(&sb, "  try { return [_makeRegexObj(pattern, new RegExp(pattern)), errors_None()]; }\n")
    str.Write(&sb, "  catch (e) { return [_makeRegexObj(pattern, null), errors_New(e.message || \"invalid regex\")]; }\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const regex_MustCompile = (pattern) => {\n")
    str.Write(&sb, "  const [re, err] = regex_Compile(pattern);\n")
    str.Write(&sb, "  if (err.message !== \"\") __skink.panic(err.message);\n")
    str.Write(&sb, "  return re;\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const regex_Match = (pattern, text) => {\n")
    str.Write(&sb, "  try { return [new RegExp(pattern).test(String(text)), errors_None()]; }\n")
    str.Write(&sb, "  catch (e) { return [false, errors_New(e.message || \"invalid regex\")]; }\n")
    str.Write(&sb, "};\n")

    // std/base64
    str.Write(&sb, "const base64_Encode = (s) => (typeof Buffer !== \"undefined\" ? Buffer.from(String(s), \"utf8\").toString(\"base64\") : btoa(String(s)));\n")
    str.Write(&sb, "const base64_Decode = (s) => {\n")
    str.Write(&sb, "  try {\n")
    str.Write(&sb, "    const out = typeof Buffer !== \"undefined\" ? Buffer.from(String(s), \"base64\").toString(\"utf8\") : atob(String(s));\n")
    str.Write(&sb, "    return [out, errors_None()];\n")
    str.Write(&sb, "  } catch (e) { return [\"\", errors_New(e.message || \"invalid base64\")]; }\n")
    str.Write(&sb, "};\n")

    // std/os & std/fs (isomorphic: Node.js + virtual in-memory fallback in browser)
    str.Write(&sb, "const _vfs = new Map();\n")
    str.Write(&sb, "const os_Getenv = (name) => (__skink.isNode && process.env ? (process.env[name] || \"\") : \"\");\n")
    str.Write(&sb, "const os_Setenv = (name, val) => { if (__skink.isNode && process.env) { process.env[name] = String(val); return true; } return false; };\n")
    str.Write(&sb, "const os_Args = () => (__skink.isNode && Array.isArray(process.argv) ? process.argv.slice(1) : [\"skinkjs\"]);\n")
    str.Write(&sb, "const os_ArgsCount = () => os_Args().length;\n")
    str.Write(&sb, "const os_Getwd = () => (__skink.isNode && typeof process.cwd === \"function\" ? process.cwd() : \"/\");\n")
    str.Write(&sb, "const os_Exit = (code = 0) => { if (__skink.isNode && typeof process.exit === \"function\") process.exit(code); else throw new Error(\"os.Exit(\" + code + \")\"); };\n")
    str.Write(&sb, "const fs_Exists = (p) => {\n")
    str.Write(&sb, "  if (_vfs.has(p)) return true;\n")
    str.Write(&sb, "  if (__skink.isNode && typeof require === \"function\") { try { return require(\"fs\").existsSync(p); } catch (_) {} }\n")
    str.Write(&sb, "  return false;\n")
    str.Write(&sb, "};\n")
    str.Write(&sb, "const fs_ReadAll = (p) => {\n")
    str.Write(&sb, "  if (_vfs.has(p)) return [_vfs.get(p), errors_None()];\n")
    str.Write(&sb, "  if (__skink.isNode && typeof require === \"function\") {\n")
    str.Write(&sb, "    try { return [require(\"fs\").readFileSync(p, \"utf8\"), errors_None()]; }\n")
