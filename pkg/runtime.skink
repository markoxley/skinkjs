    str.Write(&sb, "      return { __type: \"dom.Rect\", X: r.x || 0, Y: r.y || 0, Width: r.width || 0, Height: r.height || 0, Top: r.top || 0, Right: r.right || 0, Bottom: r.bottom || 0, Left: r.left || 0 };\n")
