    str.Write(&sb, "    cloneNode(deep) { const c = _makeHeadlessNode(this.tagName); c.id = this.id; c.textContent = this.textContent; c.className = this.className; c.value = this.value; if (deep) this.children.forEach(ch => c.appendChild(ch.cloneNode(true))); return c; },\n")
    str.Write(&sb, "    get firstElementChild() { return this.children[0] || null; },\n")
    str.Write(&sb, "    get nextElementSibling() { if (!this.parentElement) return null; const i = this.parentElement.children.indexOf(this); return i >= 0 && i + 1 < this.parentElement.children.length ? this.parentElement.children[i + 1] : null; },\n")
    str.Write(&sb, "    getBoundingClientRect() { return { x: 0, y: 0, width: this.clientWidth, height: this.clientHeight, top: 0, right: this.clientWidth, bottom: this.clientHeight, left: 0 }; },\n")
    str.Write(&sb, "    addEventListener(type, fn, opts) { if (!_listeners.has(type)) _listeners.set(type, []); _listeners.get(type).push({ fn, once: Boolean(opts && opts.once) }); },\n")
    str.Write(&sb, "    dispatchEvent(ev) { const list = (_listeners.get(ev.type) || []).slice(); for (const item of list) { item.fn(ev); if (item.once) { const arr = _listeners.get(ev.type); const ix = arr.indexOf(item); if (ix >= 0) arr.splice(ix, 1); } } },\n")
    str.Write(&sb, "    click() { this.dispatchEvent({ type: \"click\", target: this, currentTarget: this, preventDefault() {}, stopPropagation() {} }); },\n")
