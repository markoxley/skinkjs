    str.Write(&sb, "      toggle(c) { const k = String(c); if (_classes.has(k)) { _classes.delete(k); return false; } _classes.add(k); return true; },\n")
    str.Write(&sb, "      contains(c) { return _classes.has(String(c)); }\n")
