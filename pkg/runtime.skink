    str.Write(&sb, "    setAttribute(n, v) { if (n === \"id\") this.id = String(v); _attrs.set(n, String(v)); },\n")
    str.Write(&sb, "    removeAttribute(n) { if (n === \"id\") this.id = \"\"; _attrs.delete(n); },\n")
    str.Write(&sb, "    hasAttribute(n) { return n === \"id\" ? Boolean(this.id) : _attrs.has(n); },\n")
    str.Write(&sb, "    appendChild(child) { if (!child) return; if (child.parentElement) child.parentElement.removeChild(child); child.parentElement = this; this.children.push(child); return child; },\n")
    str.Write(&sb, "    prepend(child) { if (!child) return; if (child.parentElement) child.parentElement.removeChild(child); child.parentElement = this; this.children.unshift(child); },\n")
    str.Write(&sb, "    removeChild(child) { const idx = this.children.indexOf(child); if (idx >= 0) { this.children.splice(idx, 1); child.parentElement = null; } },\n")
    str.Write(&sb, "    insertBefore(newNode, refNode) { const idx = this.children.indexOf(refNode); if (idx < 0) return this.appendChild(newNode); if (newNode.parentElement) newNode.parentElement.removeChild(newNode); newNode.parentElement = this; this.children.splice(idx, 0, newNode); return newNode; },\n")
    str.Write(&sb, "    replaceWith(other) { if (!this.parentElement) return; const p = this.parentElement; const idx = p.children.indexOf(this); if (idx >= 0) { other.parentElement = p; p.children[idx] = other; this.parentElement = null; } },\n")
