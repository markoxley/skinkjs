romInt, js_FromFloat, js_FromString, js_FromBool, js_NewObject, js_NewArray, js_New, js_Eval, js_ParseJSON, js_StringifyJSON, js_Log, js_Warn, js_Error, dom_GetElementById, dom_Query, dom_QueryAll, dom_Body, dom_Head, dom_DocumentElement, dom_CreateElement, dom_CreateElementWithText, dom_CreateElementWithClass, dom_Title, dom_SetTitle, dom_OnReady, dom_OnWindowEvent, dom_WindowWidth, dom_WindowHeight, dom_ScrollTo, dom_SetTimeout, dom_ClearTimeout, dom_SetInterval, dom_ClearInterval, dom_RequestAnimationFrame, dom_CancelAnimationFrame, dom_Alert, dom_Confirm, dom_Prompt, dom_Href, dom_SetHref, dom_Pathname, dom_Search, dom_Hash, dom_SetHash, dom_Reload, dom_PushState, dom_ReplaceState, dom_OnPopState, dom_LocalStorageGet, dom_LocalStorageSet, dom_LocalStorageRemove, dom_LocalStorageClear, dom_SessionStorageGet, dom_SessionStorageSet, dom_SessionStorageRemove, dom_FetchText, dom_FetchJSON, dom_ConnectWebSocket, dom_GetCanvas2D"

    code := prelude
    if str.Equal(cfg.format, "cjs") {
        code = str.Concat("\"use strict\";\n", str.Concat(prelude, str.Concat("\nmodule.exports = { ", str.Concat(exportedNames, " };\n"))))
    } else {
        code = str.Concat(prelude, str.Concat("\nexport { ", str.Concat(exportedNames, " };\n")))
    }
    if cfg.minify {
        code = str.Concat(minify.MinifyJS(code), "\n")
    }
    return OutputUnit{
        filePath:      rtPath,
        jsCode:        code,
        sourceMapPath: "",
        sourceMapJSON: ""
    }
}

// TranspileProgram resolves, type-checks (when enabled), and transpiles the Skink
// program at cfg.entry into one or more JavaScript OutputUnits.
pub fn TranspileProgram(cfg: config.Config, skinkHome: string) -> (TranspileResult, []string) {
    var emptyUnits []OutputUnit
    var emptyErrs []string
    res := TranspileResult{units: emptyUnits, entryModule: "main", hasMain: false}

    if str.Len(cfg.entry) == 0 {
        emptyErrs = append(emptyErrs, "missing input .skink file")
        return res, emptyErrs
    }

    decls, resolveErrs := resolver.Resolve(cfg.entry, skinkHome)
    if len(resolveErrs) > 0 {
        return res, resolveErrs
    }

    if cfg.checkType {
        c := checker.newChecker()
        ok := checker.checkProgram(&c, decls)
        if !ok {
            return res, checker.Errors(&c)
        }
    }

    // Single-file bundle mode
    if cfg.bundle {
        outPath := config.ResolveOutputPath(cfg)
        t := newTranspiler(cfg, outPath)
        registerDeclarations(&t, decls)

        if cfg.includeRuntime {
            writeRaw(&t, runtime.EmitRuntimePrelude())
            writeRaw(&t, "\n")
        }

        for i := 0; i < len(decls); i = i + 1 {
            emitTopLevelDecl(&t, decls[i])
        }

        rawBody := str.String(t.out)
        str.Free(&t.out)
        wrapped := wrapModuleFormat(&t, rawBody, true)
        unit := finalizeOutputUnit(&t, outPath, wrapped)
        res.units = append(res.units, unit)
        res.hasMain = t.hasMainFn
        return res, emptyErrs
    }

    // Multi-file output mode: emit `_skink_runtime.js` + one `.js` file per user module
    outDir := cfg.outDir
    if str.Len(outDir) == 0 && str.Len(cfg.outFile) > 0 {
        dirPart := path.Dir(cfg.outFile)
        if !str.Equal(dirPart, ".") {
            outDir = dirPart
        }
    }

    if cfg.includeRuntime {
        rtUnit := buildRuntimeModuleUnit(cfg, outDir)
        res.units = append(res.units, rtUnit)
    }

    groups := groupByModules(decls)
    for gIdx := 0; gIdx < len(groups); gIdx = gIdx + 1 {
        grp := groups[gIdx]
        isEntry := gIdx == len(groups) - 1
        stem := grp.name
        if isEntry && str.Len(cfg.outFile) > 0 {
            stem = config.StripSkinkExt(path.Base(cfg.outFile))
        } else if str.Equal(stem, "main") {
            stem = config.StripSkinkExt(path.Base(cfg.entry))
        }
        modFileName := str.Concat(stem, ".js")
        modOutPath := modFileName
        if str.Len(outDir) > 0 {
            if str.EndsWith(outDir, "/") {
                modOutPath = str.Concat(outDir, modFileName)
            } else {
                modOutPath = str.Concat(outDir, str.Concat("/", modFileName))
            }
        }

        t := newTranspiler(cfg, modOutPath)
        registerDeclarations(&t, decls)
        t.currentModule = grp.name
        setCurrentSourceFile(&t, grp.filePath)

        // Emit runtime import and sibling module imports at top of file
        rtExports := "__skink, str_Len, str_Compare, str_Equal, str_Contains, str_Concat, str_Substr, str_Trim, str_StartsWith, str_EndsWith, str_IndexOf, str_LastIndexOf, str_Split, str_Join, str_Replace, str_ToLower, str_ToUpper, str_Repeat, str_NewBuilder, str_Write, str_WriteByte, str_String, str_BuilderValue, str_LenBuilder, str_Reset, str_Free, buf_NewBuffer, fmt_Itoa, fmt_Ftoa, fmt_Btoa, fmt_Sprintf1s, fmt_Sprintf1d, fmt_Sprintf1f, fmt_Sprintf2s, strconv_Itoa, strconv_Atoi, strconv_ParseInt, strconv_ParseInt64, strconv_ParseFloat, strconv_ParseBool, strconv_FormatInt, strconv_FormatFloat, strconv_FormatBool, math_Pi, math_E, math_Sqrt2, math_Ln2, math_Ln10, math_Sqrt, math_Sin, math_Cos, math_Tan, math_Asin, math_Acos, math_Atan, math_Atan2, math_Sinh, math_Cosh, math_Tanh, math_Pow, math_Exp, math_Log, math_Log10, math_Ceil, math_Floor, math_Round, math_Abs, math_Min, math_Max, math_Clamp, errors_New, errors_None, errors_Is, errors_Wrap, path_Join, path_Base, path_Dir, path_Ext, path_IsAbs, json_Null, json_FromBool, json_FromNumber, json_FromString, json_FromArray, json_FromObject, json_IsNull, json_AsBool, json_AsNumber, json_AsString, json_ArrayLen, json_ArrayGet, json_ObjectLen, json_ObjectGet, json_GetString, json_GetNumber, json_GetInt, json_GetBool, json_GetObject, json_GetArray, json_MarshalValue, json_Marshal, json_Unmarshal, time_Nanosecond, time_Microsecond, time_Millisecond, time_Second, time_Minute, time_Hour, time_NowUnix, time_NowMillis, time_NowNanos, time_SleepMillis, rand_Intn, rand_Float64, rand_IntRange, sort_Ints, sort_Floats, sort_Strings, regex_Compile, regex_MustCompile, regex_Match, base64_Encode, base64_Decode, os_Getenv, os_Setenv, os_Args, os_ArgsCount, os_Getwd, os_Exit, fs_Exists, fs_ReadAll, fs_WriteAll, fs_ReadFile, fs_WriteFile, testing_Reset, testing_Failed, testing_Errorf, testing_AssertTrue, testing_AssertFalse, testing_AssertEqualInt, testing_AssertEqualString, js_Global, js_Window, js_Document, js_Null, js_Undefined, js_FromInt, js_FromFloat, js_FromString, js_FromBool, js_NewObject, js_NewArray, js_New, js_Eval, js_ParseJSON, js_StringifyJSON, js_Log, js_Warn, js_Error, dom_GetElementById, dom_Query, dom_QueryAll, dom_Body, dom_Head, dom_DocumentElement, dom_CreateElement, dom_CreateElementWithText, dom_CreateElementWithClass, dom_Title, dom_SetTitle, dom_OnReady, dom_OnWindowEvent, dom_WindowWidth, dom_WindowHeight, dom_ScrollTo, dom_SetTimeout, dom_ClearTimeout, dom_SetInterval, dom_ClearInterval, dom_RequestAnimationFrame, dom_CancelAnimationFrame, dom_Alert, dom_Confirm, dom_Prompt, dom_Href, dom_SetHref, dom_Pathname, dom_Search, dom_Hash, dom_SetHash, dom_Reload, dom_PushState, dom_ReplaceState, dom_OnPopState, dom_LocalStorageGet, dom_LocalStorageSet, dom_LocalStorageRemove, dom_LocalStorageClear, dom_SessionStorageGet, dom_SessionStorageSet, dom_SessionStorageRemove, dom_FetchText, dom_FetchJSON, dom_ConnectWebSocket, dom_GetCanvas2D"
        if cfg.includeRuntime {
            if str.Equal(cfg.format, "cjs") {
                emitLine(&t, str.Concat("const { ", str.Concat(rtExports, " } = require(\"./_skink_runtime.js\");")))
            } else {
                emitLine(&t, str.Concat("import { ", str.Concat(rtExports, " } from \"./_skink_runtime.js\";")))
            }
        }
        for impIdx := 0; impIdx < len(grp.imports); impIdx = impIdx + 1 {
            impMod := grp.imports[impIdx]
            if str.Equal(cfg.format, "cjs") {
                emitLine(&t, str.Concat("const ", str.Concat(SanitizeJSIdent(impMod), str.Concat(" = require(\"./", str.Concat(impMod, ".js\");")))))
            } else {
                emitLine(&t, str.Concat("import * as ", str.Concat(SanitizeJSIdent(impMod), str.Concat(" from \"./", str.Concat(impMod, ".js\";")))))
            }
        }
        writeRaw(&t, "\n")

        for dIdx := 0; dIdx < len(grp.decls); dIdx = dIdx + 1 {
            emitTopLevelDecl(&t, grp.decls[dIdx])
        }

        rawBody := str.String(t.out)
        str.Free(&t.out)
        wrapped := wrapModuleFormat(&t, rawBody, isEntry)
        unit := finalizeOutputUnit(&t, modOutPath, wrapped)
        res.units = append(res.units, unit)
        if t.hasMainFn {
            res.hasMain = true
        }
    }

    return res, emptyErrs
}
